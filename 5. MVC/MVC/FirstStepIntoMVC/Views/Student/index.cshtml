@model FirstStepIntoMVC.Models.Student

@{
    // UI generated by ChatGPT.
    ViewBag.Title = "Student Details";
    Layout = "_Layout";
}

<div class="student-info">
    <h2>@Model.Name</h2>
    <h3><span class="id-label">ID:</span> @Model.Id</h3>
</div>

<style>
    .student-info {
        font-family: Arial, sans-serif;
        padding: 30px;
        background-color: #f4f7fc;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        max-width: 400px;
        margin: 20px auto;
    }

    .student-info h2 {
        font-size: 32px;
        color: #333;
        margin-bottom: 10px;
    }

    .student-info h3 {
        font-size: 24px;
        color: #555;
    }

    .student-info .id-label {
        font-weight: bold;
    }
</style>
